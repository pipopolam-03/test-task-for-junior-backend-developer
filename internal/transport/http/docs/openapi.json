{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Service API",
    "version": "1.0.0",
    "description": "CRUD API for tasks built with clean architecture."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Operations with tasks"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "List tasks",
        "responses": {
          "200": {
            "description": "Task list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Tasks"
        ],
        "summary": "Create task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskRequest"
              },
              "examples": {
                "no_schedule": {
                  "summary": "Без периодичности",
                  "value": {
                    "title": "Prepare release",
                    "description": "Collect release notes and check migrations",
                    "status": "new",
                    "interval_type": "none"
                  }
                },
                "daily": {
                  "summary": "Ежедневная: каждый 2-й день",
                  "value": {
                    "title": "Water plants",
                    "description": "Office plants",
                    "status": "new",
                    "interval_type": "daily",
                    "interval_days": 2
                  }
                },
                "monthly": {
                  "summary": "Ежемесячная: 15-го числа",
                  "value": {
                    "title": "Pay rent",
                    "description": "Monthly rent payment",
                    "status": "new",
                    "interval_type": "monthly",
                    "day_of_month": 15
                  }
                },
                "parity_even": {
                  "summary": "По четным дням",
                  "value": {
                    "title": "Even-day task",
                    "description": "Runs on even days",
                    "status": "new",
                    "interval_type": "parity",
                    "is_even": true
                  }
                },
                "specific_dates": {
                  "summary": "На конкретные даты",
                  "value": {
                    "title": "Quarterly campaign",
                    "description": "Launch campaign",
                    "status": "new",
                    "interval_type": "dates",
                    "specific_dates": [
                      "2026-04-10",
                      "2026-04-20"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "Get task by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "Tasks"
        ],
        "summary": "Update task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTaskRequest"
              },
              "examples": {
                "set_daily": {
                  "summary": "Сделать задачу ежедневной",
                  "value": {
                    "title": "Prepare release",
                    "description": "Collect release notes and check migrations",
                    "status": "in_progress",
                    "interval_type": "daily",
                    "interval_days": 1
                  }
                },
                "set_specific_dates": {
                  "summary": "Переключить на конкретные даты",
                  "value": {
                    "title": "Prepare release",
                    "description": "Run only on specific dates",
                    "status": "in_progress",
                    "interval_type": "dates",
                    "specific_dates": [
                      "2026-05-01",
                      "2026-05-15"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Tasks"
        ],
        "summary": "Delete task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "CreateTaskRequest": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "Prepare release"
          },
          "description": {
            "type": "string",
            "example": "Collect release notes and check migrations"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "in_progress",
              "done"
            ],
            "example": "new"
          },
          "interval_type": {
            "type": "string",
            "enum": [
              "none",
              "daily",
              "monthly",
              "parity",
              "dates"
            ],
            "example": "daily"
          },
          "interval_days": {
            "type": "integer",
            "minimum": 1,
            "nullable": true,
            "example": 2
          },
          "day_of_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "nullable": true,
            "example": 15
          },
          "is_even": {
            "type": "boolean",
            "nullable": true,
            "example": true
          },
          "specific_dates": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date"
            },
            "example": [
              "2026-04-10",
              "2026-04-20"
            ]
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "Prepare release"
          },
          "description": {
            "type": "string",
            "example": "Collect release notes and check migrations"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "in_progress",
              "done"
            ],
            "example": "in_progress"
          },
          "interval_type": {
            "type": "string",
            "enum": [
              "none",
              "daily",
              "monthly",
              "parity",
              "dates"
            ],
            "example": "daily"
          },
          "interval_days": {
            "type": "integer",
            "minimum": 1,
            "nullable": true,
            "example": 2
          },
          "day_of_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "nullable": true,
            "example": 15
          },
          "is_even": {
            "type": "boolean",
            "nullable": true,
            "example": true
          },
          "specific_dates": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date"
            },
            "example": [
              "2026-04-10",
              "2026-04-20"
            ]
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Prepare release"
          },
          "description": {
            "type": "string",
            "example": "Collect release notes and check migrations"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "in_progress",
              "done"
            ],
            "example": "new"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          },
          "interval_type": {
            "type": "string",
            "enum": [
              "none",
              "daily",
              "monthly",
              "parity",
              "dates"
            ],
            "example": "daily"
          },
          "interval_days": {
            "type": "integer",
            "minimum": 1,
            "nullable": true,
            "example": 2
          },
          "day_of_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "nullable": true,
            "example": 15
          },
          "is_even": {
            "type": "boolean",
            "nullable": true,
            "example": true
          },
          "specific_dates": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date"
            },
            "example": [
              "2026-04-10",
              "2026-04-20"
            ]
          },
          "next_run_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2026-04-10T00:00:00Z"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "task not found"
          }
        }
      }
    }
  }
}
